5.build Jenkins pipe line 
     #triggers ->select GitHub hook trigger

  pipe line script 


pipeline{
     agent any
        stages {
            stage('git clone #1') {
                steps{
                    git branch:'main',
                    url: 'https://github.com/gitMani-Devops/Springbootcicd.git'
                }
            }
            stage(' Maven Test #2'){
                steps {
                    sh 'mvn test'
                    echo "maven test completed"
                }
            }
            stage('sonarqube scanner #3'){
                steps{
                    withSonarQubeEnv('sonaruser'){
                        sh 'mvn org.sonarsource.scanner.maven:sonar-maven-plugin:3.9.1.2184:sonar'
                    }
                }
            }
            stage('Quality Gate #4'){
                steps{
                    waitForQualityGate abortPipeline:true
                }
            }
            stage('maven build #5'){
                steps{
                    sh 'mvn clean package'
                }
            }
            stage('Docker build #6'){
                steps{
                    sh '''
                    pwd
                    mv target/calculator-0.0.1-SNAPSHOT.war /var/lib/jenkins/workspace
                    cd ..
                    pwd
                    ls
                    docker build -t calculator:$Version .
                     rm calculator-0.0.1-SNAPSHOT.war
                    '''
                }
            }
            stage('push to Docker Hub #7'){
                steps{
                    withCredentials([
                         usernamePassword(
                            credentialsId: 'Dockerhub',
                            usernameVariable: 'DOCKER_USER',
                            passwordVariable: 'DOCKER_PASS'
                            )
                    ]) {
                    sh ' echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin'
                   sh 'docker tag calculator:$Version manidevops3008/calculator:$Version'
                   sh 'docker push manidevops3008/calculator:$Version'
                   sh 'echo $Version'
                   sh 'docker logout'
                    }
                }
            }
            stage('final#8'){
                steps{
                    sh 'echo success'
                }
            }
            
        }
}



